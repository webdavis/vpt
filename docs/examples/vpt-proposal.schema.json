{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "by",
    "summary",
    "actions",
    "tags",
    "relations"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "enum": [
        "vpt.proposal/1"
      ]
    },
    "by": {
      "type": "string"
    },
    "summary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "sources"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]{2,}:[0-5][0-9]-[0-9]{2,}:[0-5][0-9]$"
            }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "sources",
          "owner",
          "due"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]{2,}:[0-5][0-9]-[0-9]{2,}:[0-5][0-9]$"
            }
          },
          "owner": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "me"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "other"
                ],
                "properties": {
                  "other": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "due": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "date",
                  "time",
                  "sources"
                ],
                "properties": {
                  "date": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                  },
                  "time": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9]{2,}:[0-5][0-9]-[0-9]{2,}:[0-5][0-9]$"
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tag",
          "reason"
        ],
        "properties": {
          "tag": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "target",
          "reason"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
